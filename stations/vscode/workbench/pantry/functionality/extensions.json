{
    // Extensies voor functionaliteit. Opmaak staat in ../style/.
    // Zet dit bestand in een project als .vscode/extensions.json, dan stelt
    // VS Code ze vanzelf voor.
    "recommendations": [
        // Python: taal, types, debugger
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",

        // Linten en formatteren (vervangt pylint, isort, flake8)
        "charliermarsh.ruff",

        // Notebooks en data
        "ms-toolsai.jupyter",
        "ms-toolsai.datawrangler",

        // Bestanden
        "tamasfe.even-better-toml",
        "editorconfig.editorconfig",

        // Werkflow
        "fabiospampinato.vscode-todo-plus",
        "ryuta46.multi-command",
        "salomepoulain.makery-kitchen-explorer",

        // Remote
        "ms-vscode-remote.remote-ssh"
    ]
}
