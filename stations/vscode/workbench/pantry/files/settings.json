{

    // MARK: Editor
    // "security.workspace.trust.untrustedFiles": "true",

    "editor.guides.bracketPairs": "active",
    "editor.bracketPairColorization.enabled": true,
    // "editor.fontFamily": "JetBrains Mono
    // "editor.fontFamily": "fira code",
    "editor.fontFamily": "Fira Code,  Cascadia Code",
    // "terminal.integrated.fontFamily": "Fira Code, Noto Sans Mono, Noto Color Emoji, monospace",
    // "editor.codeLensFontFamily": "JetBrainsMono Nerd Font Mono",
    // "editor.fontLigatures": true,
    "editor.showFoldingControls": "never",
    "editor.unfoldOnClickAfterEndOfLine": false,
    "editor.foldingImportsByDefault": false,
    "editor.cursorBlinking": "solid",
    "editor.unicodeHighlight.ambiguousCharacters": false,
    // "editor.inlineSuggest.fontFamily": "JetBrainsMono Nerd Font Mono",
    "editor.inlineSuggest.fontFamily": "Fira Code",
    "editor.fontLigatures": true,
    // Removes breakpoint/debug margin
    "editor.glyphMargin": false,
    "editor.folding": true,
        // "errorLens.fontSize": "-2px",
    "editor.scrollbar.ignoreHorizontalScrollbarInContentHeight": true,
    "editor.occurrencesHighlight": "off",
 

    "editor.lineHeight": 1.5,
    // "editor.renderLineHighlight": "none",
    "editor.matchBrackets": "never",
    "editor.scrollbar.vertical": "hidden",
    "editor.scrollbar.verticalScrollbarSize": 0,
    "editor.wordWrap": "off",
    "editor.scrollBeyondLastColumn": 20, // changed from 300,
    "editor.scrollbar.horizontal": "auto",
    "editor.scrollbar.horizontalScrollbarSize": 2,
    "editor.codeActionsOnSave": {

    },
    "editor.renderLineHighlight": "all",
    "editor.lightbulb.enabled": "off",
    "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
    "editor.cursorWidth": 2,
    "editor.cursorStyle": "line",
    "editor.guides.highlightActiveBracketPair": false,
 

    "editor.foldingHighlight": false,
    "editor.guides.bracketPairsHorizontal": false,
    "editor.guides.indentation": true,
"editor.lineNumbers": "relative",
"editor.links": false,
"editor.minimap.showMarkSectionHeaders": true,
"editor.minimap.showRegionSectionHeaders": true,
"editor.minimap.markSectionHeaderRegex": "\\bMARK\\s*(?<separator>-?)\\s*(?<label>.*)$",
"editor.minimap.sectionHeaderFontSize": 8,
"editor.minimap.sectionHeaderLetterSpacing": 0,
"editor.minimap.side": "right",
"editor.minimap.showSlider": "always",
"editor.copyWithSyntaxHighlighting": false,
"editor.emptySelectionClipboard": false,
"editor.snippetSuggestions": "top",
"editor.detectIndentation": false,
"editor.hover.delay": 500,
"editor.hover.enabled": "on",
// "workbench.startupEditor": "none",
"editor.roundedSelection": true,
"editor.overviewRulerBorder": false,
"editor.renderControlCharacters": false,
"editor.hideCursorInOverviewRuler": true,
"editor.gotoLocation.multipleReferences": "goto",
"editor.gotoLocation.multipleTypeDefinitions": "goto",
"editor.gotoLocation.multipleDeclarations": "goto",
"editor.gotoLocation.multipleDefinitions": "goto",
"editor.gotoLocation.multipleImplementations": "goto",
"editor.minimap.renderCharacters": false,
"editor.minimap.scale": 1,
"editor.minimap.size": "fit",
"editor.minimap.maxColumn": 120,
"editor.suggest.matchOnWordStartOnly": false,
"editor.suggest.showSnippets": false,
"editor.stickyScroll.enabled": false,
"editor.fontSize": 12,
"editor.codeLensFontFamily": "fira code",
"editor.inlayHints.fontFamily": "fira code",

