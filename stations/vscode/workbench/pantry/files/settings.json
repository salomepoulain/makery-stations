         // Rule to make all docstrings yellow
            // 1. General Rule: Make ALL docstring content yellow by default.
            // This targets the broadest scope for docstrings provided by the extension.

            {   
                "name": "docstring_general",
                "scope": [
                    "string.quoted.docstring", 
                ],
                "settings":{
                    "fontStyle": "italic",
                }
            },

            {   
                "name": "docstring_text",
                "scope": [
                    "string.quoted.docstring.multi.python", 
                ],
                "settings":{
                    // "foreground": "#D7BA7D"
                    "foreground": "#E06C75"
                }
            },

            {   
                "name": "variabele",
                "scope": [
                    "docstring.variable.placeholder", 
                    "docstring.snippet.placeholder.python"
                    // "punctuation.definition.tag.end"
                ],
                "settings":{
                    "foreground": "#D19A66",
                    "fontStyle": ""
                    // "fontStyle": "underline"
                }
            },
            {   
                "name": "variabele_end",
                "scope": [
                    "docstring.variable.end"
                ],
                "settings":{
                    // "foreground": "#56B6C2",
                    "foreground": "#ABB2BF",
                    "fontStyle": ""
                }
            },
            {
                "name": "heading",
                "scope": [
                    "docstring.heading.placeholder.python",
                    "docstring.heading.end"
                ],
                "settings": {
                    "foreground": "#C678DD",
                    // "fontStyle": ""
                }
            },
            
            // 2. Specific Rule: Override for docstring TYPES to be gray.
