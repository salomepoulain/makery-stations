    // MARK: Error Lens
    "errorLens.messageBackgroundMode" : "message",
    "errorLens.enabledDiagnosticLevels": [
        "error",
        "info",
        "hint"
    ],
    // "errorLens.messageMaxChars": 1000, 
    "errorLens.fontFamily": "Cascadia Code",
  
    "errorLens.alignMessage": {
        "start": 50,
        "end": 0,
        "minimumMargin": 4,
        "padding": [
            0,
            0
        ],
        "useFixedPosition": true
    },
    "errorLens.messageTemplate": "$source | $message",
    // "errorLens.messageTemplate": "$severity $message",
    // "errorLens.severityText": [
    //     "WARNING",
    //     "ERROR",
    //     "INFO",
    //     "HINT",
    // ],
    "errorLens.padding": "0px 0.5ch",
    "errorLens.borderRadius": "0.2em",
    "errorLens.gutterIconSet": "circle",
    "errorLens.gutterIconSize": "120%",
    "errorLens.gutterIconsEnabled": false,
    // "errorLens.gutterIconsFollowCursorOverride": true,
    "errorLens.followCursor"  : "allLines",
    "errorLens.fontWeight": "normal",
    "errorLens.margin" : "1ch",
    // "errorLens.alignMessage": {
    //     "start": 0,                
    //     "end": 0,
    //     "padding": [0, 0.8],dsf
    // },
    "errorLens.enabled": true,
    "errorLens.delayMode" : "new",
    "errorLens.delay": 1,
    "errorLens.fontStyleItalic": false,
    "errorLens.editorHoverPartsEnabled": {
        "messageEnabled": true,
        "sourceCodeEnabled": true
    },
    "errorLens.statusBarIconsEnabled": true,
 
    "errorLens.problemRangeDecorationEnabled": true,
    "errorLens.statusBarColorsEnabled": true,
    "errorLens.codeLensOnClick": "showQuickFix",
    "errorLens.ignoreDirty": true,
    "errorLens.statusBarCommand": "goToLine",
    "errorLens.decorations": {
        "errorRange": {
            "textDecoration": ";background-clip:text;border-bottom:1.4px solid #e57373",
            "backgroundColor": "#fff0",
        },
        "warningRange": {
            "textDecoration": ";background-clip:text;border-bottom:1.4px solid #ffb74d",
            "backgroundColor": "#fff0",
        },
        "infoRange": {
            "textDecoration": ";background-clip:text;border-bottom:1.4x solid #4fc3f7",
            "backgroundColor": "#fff0",
        },
        "hintRange": {
            // "textDecoration": ";background-clip:text;border-bottom:1.5px solid #81c784",
            "backgroundColor": "#fff0",
        },

        "errorMessage": {
            "color": "#e5737350",
            // "padding": "2px 6px",
            // "backgroundColor": "#fff0",
            // "fontWeight": "normal"
        },
        "warningMessage": {
            "backgroundColor": "#ffb74d10",
            "color": "#ffb74d50",
            // "padding": "0.15em 0.7em",   // (top-bottom, left-right)
            // "borderRadius": "0.3em",     // (rounded corners helps the look)
            // "fontWeight": "normal",
            // "fontSize": "1em",           // (sometimes helps baseline alignment)
            // "margin": "0 0.2em"          // (optional, adds space before/after message)
        },

        "infoMessage": {
            "color": "#4fc3f750",
            "backgroundColor": "#4fc3f710"
            // "backgroundColor": "#fff0",
            // "fontWeight": "normal"
        },

        "hintMessage": {
            "color": "#81c78425",
            "backgroundColor": "#fff0", 

            // "fontWeight": "normal"
            // "fontSize": "7px"
        }

    },
    "errorLens.excludeByMessage": [
        "code:W0511"
    ],
    "errorLens.messageEnabled": false,
    "errorLens.ignoreUntitled": true,
    "errorLens.respectUpstreamEnabled": {
        "statusBar": true
    },
    "errorLens.statusBarIconsPriority": 10000,
    "errorLens.statusBarIconsTargetProblems": "visibleEditors",
    "errorLens.statusBarMessageEnabled": true,
    "errorLens.statusBarMessageType": "activeLine",
    "errorLens.statusBarIconsUseBackground": false,

