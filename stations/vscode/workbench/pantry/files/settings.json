    // --- TERMINAL SETTINGS ---
    // This font is ONLY for the INTEGRATED TERMINAL panel.
    "terminal.integrated.fontFamily": "Fira Code, Cascadia Code, MesloLGM Nerd Font Mono, Noto Sans Mono",
    // "terminal.integrated.fontFamily": "",
    "terminal.integrated.lineHeight": 1,
    // MARK: OS-Specific
    // NOTE: "[windows]" is a *language* scope in settings.json, not an OS scope —
    // it never matched anything here. Real per-OS keys use a .windows/.osx/.linux
    // suffix instead (see terminal.integrated.defaultProfile.windows below).
    "terminal.external.windowsExec": "wt.exe",
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.cursorStyleInactive": "line",
    "terminal.integrated.ignoreBracketedPasteMode": true,
    "terminal.integrated.accessibleViewPreserveCursorPosition": true,
    "terminal.integrated.cursorWidth": 2,
    "terminal.integrated.scrollback": 100000,
    "multiCommand.commands": [
    {
        "command": "multiCommand.foldThenFoldDocstrings",
        "sequence": [
            "editor.unfoldRecursively",
            "pylance.foldDocstrings"  // <-- this is the Pylance command, adjust if needed
        ]
    }
],
"terminal.integrated.profiles.windows": {
    "PowerShell": {
        "source": "PowerShell",
        "icon": "terminal-powershell"
    },
    "Command Prompt": {
        "path": [
            "${env:windir}\\Sysnative\\cmd.exe",
            "${env:windir}\\System32\\cmd.exe"
        ],
        "args": [],
        "icon": "terminal-cmd"
    },
    "Git Bash": {
        "source": "Git Bash"
    },
    "Ubuntu (WSL)": {
        "path": "C:\\WINDOWS\\System32\\wsl.exe",
        "args": [
            "-d",
            "Ubuntu"
        ]
    }
},
"terminal.integrated.defaultProfile.windows": "Ubuntu (WSL)",
"terminal.integrated.fontSize": 12,
