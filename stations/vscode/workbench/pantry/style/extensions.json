{
    // Extensions that settings.json in this folder needs.
    // As .vscode/extensions.json in a project, VS Code will recommend them.
    "recommendations": [
        // Theme and icons
        "akamud.vscode-theme-onedark",
        "thang-nm.flow-icons",
        "nionx01.polar-black-themes",

        // Editor display
        "usernamehw.errorlens",
        "rodolphebarbanneau.python-docstring-highlighter",
        "aaron-bond.better-comments",
        "mguellsegarra.highlight-on-copy",
        "drcika.apc-extension",
        "antfu.file-nesting",

        // Notebooks
        "koloskerekes.notebook-cell-index",
        "community.notebook-minimap"
    ]
}
