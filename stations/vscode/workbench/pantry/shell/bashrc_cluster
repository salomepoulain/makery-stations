# Shell config for a server without internet. Nothing to install, nothing
# reaches the network.
# Drag the whole shell/ folder to ~/.shell, then load it from ~/.bashrc with:
#   [ -f ~/.shell/bashrc_cluster ] && . ~/.shell/bashrc_cluster

# Only in a terminal you type in, so scp and VS Code's own server stay untouched.
[[ $- == *i* ]] || return

# History: big, no duplicates, shared between terminals.
HISTSIZE=100000
HISTFILESIZE=100000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend checkwinsize
PROMPT_COMMAND="history -a${PROMPT_COMMAND:+; $PROMPT_COMMAND}"

# Up and down arrows search history for what you've typed so far.
bind '"\e[A": history-search-backward'
bind '"\e[B": history-search-forward'
bind 'set completion-ignore-case on'
bind 'set show-all-if-ambiguous on'

# ls looks like lsd (see lsd.sh); ll is the normal long listing.
[ -f ~/.shell/lsd.sh ] && . ~/.shell/lsd.sh
alias ll='command ls -lh --color=auto --group-directories-first'
alias la='ls -a'
alias lt='tree -C 2>/dev/null || find . -maxdepth 2'
alias c='printf "\033c"'
alias pip=pip3

# Prompt in the style of Powerlevel10k lean (see prompt.sh).
[ -f ~/.shell/prompt.sh ] && . ~/.shell/prompt.sh
