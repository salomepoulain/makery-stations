    "scm.diffDecorationsGutterVisibility": "hover",
    "scm.diffDecorationsGutterWidth": 2,
    "scm.diffDecorationsIgnoreTrimWhitespace": "true",
    "debug.showInlineBreakpointCandidates": false,
    "debug.gutterMiddleClickAction": "none",
    "diffEditor.renderGutterMenu": false,
    "testing.gutterEnabled": false,
    "diffEditor.renderSideBySide": false,
    "notebook.diff.overviewRuler": true,

    // MARK: Error Lens (usernamehw.errorlens)
    "errorLens.messageBackgroundMode": "message",
    "errorLens.enabledDiagnosticLevels": [
        "error",
        "info",
        "hint"
    ],
    "errorLens.fontFamily": "Cascadia Code",
    "errorLens.alignMessage": {
        "start": 50,
        "end": 0,
        "minimumMargin": 4,
        "padding": [
            0,
            0
        ],
        "useFixedPosition": true
    },
    "errorLens.messageTemplate": "$source | $message",
    "errorLens.padding": "0px 0.5ch",
    "errorLens.borderRadius": "0.2em",
    "errorLens.gutterIconSet": "circle",
    "errorLens.gutterIconSize": "120%",
    "errorLens.gutterIconsEnabled": false,
    "errorLens.followCursor": "allLines",
    "errorLens.fontWeight": "normal",
    "errorLens.margin": "1ch",
    "errorLens.enabled": true,
    "errorLens.delayMode": "new",
    "errorLens.delay": 1,
    "errorLens.fontStyleItalic": false,
    "errorLens.editorHoverPartsEnabled": {
        "messageEnabled": true,
        "sourceCodeEnabled": true
    },
    "errorLens.statusBarIconsEnabled": true,
    "errorLens.problemRangeDecorationEnabled": true,
    "errorLens.statusBarColorsEnabled": true,
    "errorLens.codeLensOnClick": "showQuickFix",
    "errorLens.ignoreDirty": true,
    "errorLens.statusBarCommand": "goToLine",
    "errorLens.decorations": {
        "errorRange": {
            "textDecoration": ";background-clip:text;border-bottom:1.4px solid #e57373",
            "backgroundColor": "#fff0"
        },
        "warningRange": {
            "textDecoration": ";background-clip:text;border-bottom:1.4px solid #ffb74d",
            "backgroundColor": "#fff0"
        },
        "infoRange": {
            "textDecoration": ";background-clip:text;border-bottom:1.4x solid #4fc3f7",
            "backgroundColor": "#fff0"
        },
        "hintRange": {
            "backgroundColor": "#fff0"
        },
        "errorMessage": {
            "color": "#e5737350"
        },
        "warningMessage": {
            "backgroundColor": "#ffb74d10",
            "color": "#ffb74d50"
        },
        "infoMessage": {
            "color": "#4fc3f750",
            "backgroundColor": "#4fc3f710"
        },
        "hintMessage": {
            "color": "#81c78425",
            "backgroundColor": "#fff0"
        }
    },
    "errorLens.excludeByMessage": [
        "code:W0511"
    ],
    "errorLens.messageEnabled": false,
    "errorLens.ignoreUntitled": true,
    "errorLens.respectUpstreamEnabled": {
        "statusBar": true
    },
    "errorLens.statusBarIconsPriority": 10000,
    "errorLens.statusBarIconsTargetProblems": "visibleEditors",
    "errorLens.statusBarMessageEnabled": true,
    "errorLens.statusBarMessageType": "activeLine",
    "errorLens.statusBarIconsUseBackground": false,

    // MARK: Better Comments (aaron-bond.better-comments)
    "better-comments.highlightPlainText": true,

    // MARK: Highlight on Copy (mguellsegarra.highlight-on-copy)
    "highlightOnCopy.backgroundColor": "rgba(146, 169, 233, .3)",
    "highlightOnCopy.foregroundColor": "#fff",
    "highlightOnCopy.timeout": 200,

    // MARK: Notebooks
    "notebook.markup.fontSize": 15,
    "notebook.compactView": true,
    "notebook.output.wordWrap": true,
    "notebook.output.fontFamily": "fira code",
    "notebook.outline.showCodeCellSymbols": false,
    "notebook.markup.fontFamily": "CMU Serif, STIX Two Text",
    "notebook.lineNumbers": "on",

    // MARK: Notebook Cell Index (koloskerekes.notebook-cell-index)
    "notebookCellIndex.showTotal": true,
    "notebookCellIndex.customFormat": "{section}. {sectionTitle} | {n}/{total} | {grandTotal}",
    "notebookCellIndex.resetCounterOnSection": "h1-h2",

    // MARK: Notebook Minimap (community.notebook-minimap)
    "notebookMinimap.fillPanelWidth": false,
    "notebookMinimap.renderCharacters": true,
    "notebookMinimap.enableIndent": true,
    "notebookMinimap.headingSize": "h1",
    "notebookMinimap.layoutMode": "fill",

    // MARK: Chat-UI
    "chat.commandCenter.enabled": false,
    "inlineChat.lineNaturalLanguageHint": false,
    "chat.viewSessions.orientation": "stacked",

    // ===== functionality/ =====
    // Always: how VS Code behaves.

    // MARK: Files and saving
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "files.autoSave": "onFocusChange",
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,

    // MARK: Editor behavior
    "editor.unfoldOnClickAfterEndOfLine": false,
    "editor.foldingImportsByDefault": false,
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "editor.wordWrap": "off",
    "editor.links": false,
    "editor.copyWithSyntaxHighlighting": false,
    "editor.emptySelectionClipboard": true,
    "editor.snippetSuggestions": "top",
    "editor.detectIndentation": false,
    "editor.hover.delay": 500,
    "editor.hover.enabled": "on",
    "editor.gotoLocation.multipleReferences": "goto",
    "editor.gotoLocation.multipleTypeDefinitions": "goto",
    "editor.gotoLocation.multipleDeclarations": "goto",
    "editor.gotoLocation.multipleDefinitions": "goto",
    "editor.gotoLocation.multipleImplementations": "goto",
    "editor.suggest.matchOnWordStartOnly": false,
    "editor.suggest.showSnippets": false,

    // MARK: Tabs and startup
    "workbench.editor.enablePreview": false,
    "workbench.editor.enablePreviewFromQuickOpen": false,
    "workbench.startupEditor": "none",

    // MARK: Git
    "git.autofetch": true,
    "githubRepositories.autoFetch.enabled": true,
    "git.confirmSync": false,
    "git.suggestSmartCommit": false,
    "testing.defaultGutterClickAction": "contextMenu",
    "diffEditor.ignoreTrimWhitespace": false,

    // MARK: Terminal
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.ignoreBracketedPasteMode": true,
    "terminal.integrated.accessibleViewPreserveCursorPosition": true,
    "terminal.integrated.scrollback": 100000,
    "terminal.integrated.gpuAcceleration": "on",

    // MARK: Notebooks and markdown
    "markdown.preview.linkify": false,
    "notebook.output.scrolling": true,
    "notebook.output.textLineLimit": 20,

    // MARK: Remote SSH (ms-vscode-remote.remote-ssh), without hosts or paths
    "remote.autoForwardPortsSource": "hybrid",
    "remote.SSH.remoteServerListenOnSocket": true,

    // MARK: Privacy
    "telemetry.telemetryLevel": "off",

    // MARK: Copilot agent (AGENTS.md and skills)
    // Read the AGENTS.md the copilot station writes in the project root.
    // Skills in .agents/skills are found without a setting.
    "chat.useAgentsMdFile": true,
    // Don't also pull in CLAUDE.md / CLAUDE.local.md: AGENTS.md carries the
    // same rules, so Copilot gets them once.
    "chat.useClaudeMdFile": false,

    // ===== addons/ =====
    // Per project: only take this along if you use these extensions.

    // MARK: Python (ms-python.python, ms-python.vscode-pylance)
    "[python]": {
        "editor.defaultFormatter": null,
        "editor.formatOnSave": false,
        "diffEditor.ignoreTrimWhitespace": false
    },
    "python.terminal.activateEnvironment": false,
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": [
        "--rootdir=.",
        "--asyncio-mode=auto"
    ],
    "python.testing.cwd": ".",
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.inlayHints.pytestParameters": true,
    "python.analysis.autoFormatStrings": true,
    "python.analysis.completeFunctionParens": true,
    "python.analysis.generateWithTypeAnnotation": true,
    "python.analysis.inlayHints.functionReturnTypes": true,
    "python.analysis.showOnlyDirectDependenciesInAutoImport": true,
    "python.analysis.typeEvaluation.deprecateTypingAliases": true,
    "python.analysis.typeEvaluation.enableReachabilityAnalysis": true,
    "python.analysis.typeEvaluation.disableBytesTypePromotions": true,
    "python.analysis.typeEvaluation.strictDictionaryInference": true,
    "python.analysis.typeEvaluation.strictListInference": true,
    "python.analysis.typeEvaluation.strictSetInference": true,
    "python.analysis.diagnosticSeverityOverrides": {},

    // MARK: Jupyter (ms-toolsai.jupyter)
    "jupyter.askForKernelRestart": false,
    // No widget code from CDNs: nothing gets downloaded.
    "jupyter.widgetScriptSources": [],
    "jupyter.enableExtendedPythonKernelCompletions": true,

    // MARK: Data Wrangler (ms-toolsai.datawrangler)
    "dataWrangler.defaultViewingFilterOptions": "advanced",
    "dataWrangler.outputRenderer.columnInsights.displayByDefault": true,

    // MARK: Multi Command (ryuta46.multi-command)
    "multiCommand.commands": [
        {
            "command": "multiCommand.foldThenFoldDocstrings",
            "sequence": [
                "editor.unfoldRecursively",
                "pylance.foldDocstrings"
            ]
        }
    ]
