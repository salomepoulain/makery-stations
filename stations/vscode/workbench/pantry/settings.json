{
    // Everything in one file: style/ + functionality/ + addons/.
    // Paste this into your user settings.json (Preferences: Open User Settings (JSON)).

    // ===== style/ =====
    // Always: how VS Code looks.

    // MARK: Themes and icons
    "workbench.colorTheme": "Atom One Dark",
    "workbench.iconTheme": "flow-dim",
    "workbench.productIconTheme": "polar-black-ui",
    "jetbrains-file-icon-theme.enableGoTestIcons": true,
    "catppuccin-icons.hidesExplorerArrows": true,
    "catppuccin-noctis-icons.hidesExplorerArrows": false,
    "flow-icons.activeIconPack": {},
    "flow-icons.files.associations": {
        ".gitignore": "git",
        "TODO": "todo",
        "todo": "todo"
    },
    "flow-icons.folders.associations": {
        ".venv": "python",
        ".makery": "firebase",
        "report": "docs",
        "output": "content",
        ".local": "archive",
        "__LOCAL__": "archive",
        "__STASH__": "dump",
        "__TRASH__": "trash",
        ".vault": "obsidian",
        ".ruff_cache": "blue",
        ".pytest_cache": "blue",
        ".mypy_cache": "blue"
    },
    "flow-icons.folderColor": "blue",
    "flow-icons.hidesExplorerArrows": false,

