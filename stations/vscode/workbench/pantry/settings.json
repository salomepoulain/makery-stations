    // MARK: Fonts
    "editor.fontFamily": "Fira Code,  Cascadia Code",
    "editor.inlineSuggest.fontFamily": "Fira Code",
    "editor.fontLigatures": true,
    "editor.lineHeight": 1.5,
    "editor.fontSize": 12,
    "editor.codeLensFontFamily": "fira code",
    "editor.inlayHints.fontFamily": "fira code",
    "scm.inputFontSize": 12,
    "chat.editor.fontSize": 12,
    "chat.fontSize": 12,
    "debug.console.fontFamily": "Fira Code",
    "debug.console.fontSize": 12,
    "markdown.preview.fontSize": 14,

    // MARK: Editor: cursor, guides, folding, highlights
    "editor.guides.bracketPairs": "active",
    "editor.bracketPairColorization.enabled": true,
    "editor.showFoldingControls": "never",
    "editor.cursorBlinking": "solid",
    "editor.glyphMargin": false,
    "editor.folding": true,
    "editor.occurrencesHighlight": "off",
    "editor.matchBrackets": "never",
    "editor.scrollBeyondLastColumn": 20,
    "editor.renderLineHighlight": "all",
    "editor.lightbulb.enabled": "off",
    "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
    "editor.cursorWidth": 2,
    "editor.cursorStyle": "line",
    "editor.guides.highlightActiveBracketPair": false,
    "editor.foldingHighlight": false,
    "editor.guides.bracketPairsHorizontal": false,
    "editor.guides.indentation": true,
    "editor.lineNumbers": "relative",
    "editor.roundedSelection": true,
    "editor.renderControlCharacters": false,
    "editor.stickyScroll.enabled": false,

    // MARK: Editor: scrollbar, minimap, overview ruler
    "editor.scrollbar.ignoreHorizontalScrollbarInContentHeight": true,
    "editor.scrollbar.vertical": "hidden",
    "editor.scrollbar.verticalScrollbarSize": 0,
    "editor.scrollbar.horizontal": "auto",
    "editor.scrollbar.horizontalScrollbarSize": 2,
    "editor.minimap.showMarkSectionHeaders": true,
    "editor.minimap.showRegionSectionHeaders": true,
    "editor.minimap.markSectionHeaderRegex": "\\bMARK\\s*(?<separator>-?)\\s*(?<label>.*)$",
    "editor.minimap.sectionHeaderFontSize": 8,
    "editor.minimap.sectionHeaderLetterSpacing": 0,
    "editor.minimap.side": "right",
    "editor.minimap.showSlider": "always",
    "editor.overviewRulerBorder": false,
    "editor.hideCursorInOverviewRuler": true,
    "editor.minimap.renderCharacters": false,
    "editor.minimap.scale": 1,
    "editor.minimap.size": "fit",
    "editor.minimap.maxColumn": 120,
    "debug.showBreakpointsInOverviewRuler": false,

    // MARK: Workbench layout
    "window.autoDetectHighContrast": false,
    "workbench.preferredHighContrastLightColorTheme": "Dark Modern",
    "workbench.editor.tabSizing": "fixed",
    "workbench.reduceMotion": "on",
    "workbench.editor.tabSizingFixedMaxWidth": 120,
    "workbench.activityBar.location": "bottom",
    "workbench.statusBar.visible": false,
    "workbench.navigationControl.enabled": false,
    "window.commandCenter": false,
    "workbench.layoutControl.enabled": false,
    "workbench.tree.indent": 20,
    "workbench.tree.renderIndentGuides": "none",
    "window.border": "off",
    "workbench.tips.enabled": false,
    "workbench.editor.empty.hint": "hidden",
    "workbench.layoutControl.type": "menu",
    "window.customTitleBarVisibility": "windowed",
    "workbench.experimental.modernUI": true,
    "problems.decorations.enabled": false,
    "breadcrumbs.enabled": false,

    // MARK: APC (drcika.apc-extension)
    "apc.menubar.compact": true,

    // MARK: Explorer and file nesting (antfu.file-nesting)
    "explorer.sortOrder": "type",
    "explorer.decorations.badges": false,
    "explorer.compactFolders": false,
    "explorer.decorations.colors": true,
    "explorer.fileNesting.patterns": {
        "//": "Last update at 16/10/2026, 15:49:41",
        ".agent": ".agent, .claude, .cline, .codebuddy, .codex, .commandcode, .continue, .crush, .cursor, .factory, .gemini, .goose, .junie, .kilocode, .kiro, .kode, .mcpjam, .mux, .neovate, .opencode, .openhands, .pi, .pochi, .qoder, .qwen, .roo, .trae, .windsurf, .zencoder",
        ".clang-tidy": ".clang-format, .clangd, compile_commands.json",
        ".env": "*.env, .env.*, .envrc, env.d.ts",
        ".gitignore": ".gitattributes, .gitmodules, .gitmessage, .lfsconfig, .mailmap, .git-blame*",
